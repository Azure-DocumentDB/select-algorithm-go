# Replace every <placeholder> before running. No secrets or real resources belong in Git.
# Use a text-embedding-3-small deployment with 1536 dimensions for these sample inputs.
DOCUMENTDB_CLUSTER_NAME=<your-cluster-name>
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_EMBEDDING_MODEL=<embedding-deployment-name>
AZURE_DOCUMENTDB_DATABASENAME=Hotels
DATA_FILE_WITH_VECTORS=data/Hotels_Vector.json
EMBEDDED_FIELD=DescriptionVector
EMBEDDING_DIMENSIONS=1536
LOAD_SIZE_BATCH=100
QUERY_TEXT=luxury hotel near the beach
TOP_K=5
