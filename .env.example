# Placeholders only. The program reads process env; it NEVER loads/executes .env.
# No model resource required for the default precomputed-vector quickstart.
MONGO_AUTH_MODE=oidc
MONGO_HOST=<cluster>.global.mongocluster.cosmos.azure.com
# OIDC: unset MONGO_CONNECTION_STRING. Optional MONGO_OIDC_USERNAME if required.
# Native: set MONGO_AUTH_MODE=connection-string and inject MONGO_CONNECTION_STRING
# via your secret mechanism. Azure mongodb+srv only; no TLS bypass; SCRAM only.
MONGO_DATABASE=go_disposable_example_20261012
MONGO_COLLECTION_PREFIX=hotels
# MONGO_COLLECTION is forbidden: nine distinct algorithm/metric collections.
VECTOR_SEARCH_ALLOW_WRITES=false
VECTOR_SEARCH_TIMEOUT=10m
VECTOR_SEARCH_CASE_TIMEOUT=1m
EMBEDDING_MODE=offline
DATA_FILE_WITH_VECTORS=data/Hotels_Vector.json
QUERY_VECTOR_FILE=data/query-vector.json
EMBEDDED_FIELD=DescriptionVector
SEED_ID_FIELD=HotelId
EMBEDDING_DIMENSIONS=1536
LOAD_SIZE_BATCH=100
TOP_K=5
# Explicit opt-in live tests ALSO require VECTOR_SEARCH_LIVE_TEST=1.
#
# OPTIONAL, BILLABLE, NOT LIVE VALIDATED (S0 account eligibility blocked):
# EMBEDDING_MODE=azure-openai
# Unset QUERY_VECTOR_FILE before model mode.
# AZURE_OPENAI_EMBEDDING_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_EMBEDDING_MODEL=<compatible-deployment>
# QUERY_TEXT=luxury hotel near the beach
# Inject AZURE_OPENAI_EMBEDDING_KEY secretly, or use Azure Identity.
